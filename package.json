{
  "name": "supame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SupaMe — desktop meme editor with a local web interface",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node desktop/tray.mjs",
    "browser": "node desktop/launcher.mjs",
    "serve": "npm run build && node desktop/launcher.mjs",
    "icon": "node desktop/gen-icon.mjs"
  },
  "dependencies": {
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.0.18",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/jetbrains-mono": "^5.0.19",
    "@fontsource/marck-script": "^5.0.15",
    "@fontsource/oswald": "^5.0.16",
    "@fontsource/roboto-condensed": "^5.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "systray2": "^2.1.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
